<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <NoWarn>CS8618;CA2022;CA1416</NoWarn>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bleeps</AssemblyName>
    <RootNamespace>Bleeps</RootNamespace>
    <AssemblyVersion>1.0.11.0</AssemblyVersion>
    <FileVersion>1.0.11.0</FileVersion>
    <Company>PA5DJ</Company>
    <Product>Bleeps</Product>
    <Copyright>PA5DJ</Copyright>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Bleeps.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Everything this program needs is in this repository (v1.0.9, PA5DJ: "a project standing on its own, separate from
         ShackAssistant"): the shared code that used to be linked from ShackAssistant is in Shared\ (a copy of its own), the
         emoji pictures in Twemoji\, the Hamlib DLLs in ..\..\hamlib\. -->
    <HamlibBin>$(MSBuildThisFileDirectory)..\..\hamlib\</HamlibBin>
  </PropertyGroup>

  <!-- Shared\*.cs and Shared\Protocol\*.cs are ordinary project files (the SDK compiles every .cs here). -->

  <ItemGroup>
    <EmbeddedResource Include="Splash.png">
      <LogicalName>Splash.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Bleeps.ico">
      <LogicalName>Bleeps.ico</LogicalName>
    </EmbeddedResource>
    <!-- The emoji pictures (Twemoji 72 x 72, CC-BY 4.0) - Twemoji\LICENSE.txt. -->
    <EmbeddedResource Include="Twemoji\*.png">
      <LogicalName>Twemoji.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="Twemoji\LICENSE.txt">
      <Link>Twemoji-LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Hamlib next to the exe: HamlibNative looks in <exe>\hamlib first. LGPL - its licence travels along (hamlib\COPYING.LIB.txt). -->
  <ItemGroup>
    <Content Include="$(HamlibBin)libhamlib-4.dll"><Link>hamlib\libhamlib-4.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(HamlibBin)libgcc_s_seh-1.dll"><Link>hamlib\libgcc_s_seh-1.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(HamlibBin)libwinpthread-1.dll"><Link>hamlib\libwinpthread-1.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(HamlibBin)libusb-1.0.dll"><Link>hamlib\libusb-1.0.dll</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="$(HamlibBin)COPYING.LIB.txt"><Link>hamlib\COPYING.LIB.txt</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>

</Project>
